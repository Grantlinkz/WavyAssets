# WavyAssets Sovereign Backend User Dashboard Environment Configuration
NODE_ENV=development
PORT=4001

# Database Configuration (SQLite local dev / PostgreSQL production)
DATABASE_URL="file:./dev.db"

# JWT Authentication Secrets
JWT_SECRET="CHANGE_ME_IN_PRODUCTION_JWT_SECRET_MIN_32_CHARS"
JWT_ACCESS_SECRET="CHANGE_ME_IN_PRODUCTION_JWT_ACCESS_SECRET_MIN_32_CHARS"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_SECRET="CHANGE_ME_IN_PRODUCTION_JWT_REFRESH_SECRET_MIN_32_CHARS"
JWT_REFRESH_EXPIRATION="7d"

# Cross-Domain Handoff Secret (Shared with Backend/landing-page)
HANDOFF_TICKET_SECRET="CHANGE_ME_IN_PRODUCTION_HANDOFF_TICKET_SECRET_MIN_32_CHARS"

# Symmetric AES-256-GCM Encryption Key (64-character hex string)
ENCRYPTION_KEY_HEX="CHANGE_ME_IN_PRODUCTION_64_HEX_CHARACTERS_KEY_0000000000000000000000"
CIPHER_KEY_HEX="CHANGE_ME_IN_PRODUCTION_64_HEX_CHARACTERS_KEY_0000000000000000000000"

# Document Vault HMAC Secret
DOCUMENT_HMAC_SECRET="CHANGE_ME_IN_PRODUCTION_DOCUMENT_HMAC_SECRET_32_CHARS"
AUDIT_LOG_HMAC_SECRET="CHANGE_ME_IN_PRODUCTION_AUDIT_LOG_HMAC_SECRET_32_CHARS"

# CORS Allowed Origins (Comma-separated)
FRONTEND_ORIGINS="http://localhost:5173,http://localhost:5174"
