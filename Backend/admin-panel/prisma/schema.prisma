// ==============================================================================
// Prisma Schema — WavyAssets Global Database Model (Unified)
// ==============================================================================

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ------------------------------------------------------------------------------
// Administrative Identity, RBAC & Audit Models
// ------------------------------------------------------------------------------

model AdminUser {
  id             String         @id @default(uuid())
  email          String         @unique
  fullName       String
  passphraseHash String         // Argon2id
  role           String         @default("DESK_LEAD") // SUPER_ADMIN | TREASURY_OFFICER | COMPLIANCE_OFFICER | CONCIERGE | DESK_LEAD
  totpSecretHash String?        // Encrypted TOTP secret for 2FA
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  sessions       AdminSession[]
  auditLogs      AdminAuditLog[]
  signOffs       TreasurySignOff[]
}

model AdminSession {
  id                String    @id @default(uuid())
  adminId           String
  admin             AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
  refreshTokenHash  String    @unique
  ipAddress         String?
  userAgent         String?
  expiresAt         DateTime
  createdAt         DateTime  @default(now())
}

model AdminAuditLog {
  id            String     @id @default(uuid())
  adminId       String?
  admin         AdminUser? @relation(fields: [adminId], references: [id])
  action        String     // e.g. "USER_SUSPEND", "BALANCE_CREDIT", "KYC_APPROVE"
  targetEntity  String     // "User", "LedgerAccount", "VipCard", "DepositRail"
  targetId      String?
  diffBefore    String?    // Redacted JSON string of state before mutation
  diffAfter     String?    // Redacted JSON string of state after mutation
  reason        String?    // Mandatory justification
  ipAddressHash String
  userAgent     String?
  createdAt     DateTime   @default(now())

  @@index([adminId])
  @@index([action])
  @@index([createdAt])
}

// ------------------------------------------------------------------------------
// Global Deposit Rail Configuration Models
// ------------------------------------------------------------------------------

model FiatDepositRailConfig {
  id              String   @id @default("GLOBAL_FIAT_RAIL")
  beneficiaryName String   @default("WavyAssets Supreme Custody AG")
  depositoryBank  String?  @default("UBS Switzerland AG (Zurich Enclave)")
  swissIban       String   @default("CH93 0023 8812 4019 8821 0")
  bicSwift        String   @default("UBSWCHZH80A")
  clearingRail    String   @default("Swiss SIC RTGS / Fedwire DvP")
  memoFormat      String   @default("WY-{USER_REF}-TREASURY-03")
  updatedAt       DateTime @updatedAt
  updatedBy       String?
}

model CryptoDepositRailConfig {
  id              String   @id @default(uuid())
  asset           String   // USDC | USDT | BTC | ETH
  network         String   // ERC-20 | BEP-20 | Polygon | TRC-20 | Bitcoin Native | Arbitrum | Optimism
  vaultAddress    String
  minDepositUsd   Float    @default(500.0)
  confirmations   Int      @default(3)
  isActive        Boolean  @default(true)
  updatedAt       DateTime @updatedAt
  updatedBy       String?

  @@unique([asset, network])
}

// ------------------------------------------------------------------------------
// Treasury Dual-Sign-Off Models (FINMA AMLA Article 14)
// ------------------------------------------------------------------------------

model TreasurySignOff {
  id            String    @id @default(uuid())
  withdrawalId  String
  officerId     String
  officer       AdminUser @relation(fields: [officerId], references: [id])
  action        String    @default("APPROVE") // APPROVE | REJECT
  signatureNote String?
  notes         String?
  signedAt      DateTime  @default(now())

  @@unique([withdrawalId, officerId])
}

// ------------------------------------------------------------------------------
// Identity, Session & Security Models
// ------------------------------------------------------------------------------

model User {
  id                 String               @id @default(uuid())
  email              String               @unique
  fullName           String?
  passphraseHash     String
  tier               String               @default("PRIVATE_WEALTH") // RETAIL | PRIVATE_WEALTH | INSTITUTIONAL
  kycTier            String               @default("TIER_1")         // TIER_1 | TIER_2 | TIER_3
  isCorporate        Boolean              @default(false)
  isActive           Boolean              @default(true)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  sessions           Session[]
  otpCodes           OtpCode[]
  simulationIntent   SimulationIntent?
  webAuthnKeys       WebAuthnCredential[]
  whitelistAddresses WhitelistDestination[]
  kycDocuments       KycDocument[]
  
  // Ledger & Portfolio
  ledgerAccounts     LedgerAccount[]
  cryptoHoldings     CryptoHolding[]
  dcaSchedules       DcaSchedule[]
  stockPositions     StockPosition[]
  stockOrders        StockOrder[]
  aiFundPositions    AiFundPosition[]
  realEstateShares   RealEstateShare[]
  carShares          CarShare[]
  driveBookings      DriveBooking[]
  vipCard            VipCard?
  auditLogs          AuditLog[]
}

model Session {
  id                String   @id @default(uuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash  String   @unique
  handoffTicketHash String?  @unique
  ipAddress         String?
  userAgent         String?
  expiresAt         DateTime
  createdAt         DateTime @default(now())
}

model OtpCode {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  email      String
  hashedCode String
  attempts   Int      @default(0)
  isConsumed Boolean  @default(false)
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([email, expiresAt])
}

model LeadInquiry {
  id                 String    @id @default(uuid())
  fullNameEncrypted  String
  workEmailEncrypted String
  workEmailHash      String
  companyName        String
  websiteUrl         String?
  telegramEncrypted  String?
  service            String
  allocationRange    String
  domainScore        Float     @default(1.0)
  isSpam             Boolean   @default(false)
  crmDispatched      Boolean   @default(false)
  status             String?   @default("NEW")
  notes              String?
  location           String?   @default("Zurich, Switzerland")
  custodyPreference  String?   @default("Qualified Institutional Custody")
  investmentWindow   String?   @default("Immediate (< 30 days)")
  ipAddress          String?   @default("194.230.144.1")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime? @default(now()) @updatedAt

  @@index([workEmailHash])
}

model SimulationIntent {
  id             String   @id @default(uuid())
  token          String   @unique
  userId         String?  @unique
  user           User?    @relation(fields: [userId], references: [id])
  capitalAmount  Float
  riskPosture    Int
  projectedYield Float
  expiresAt      DateTime
  createdAt      DateTime @default(now())
}

model NewsletterSubscriber {
  id                String    @id @default(uuid())
  email             String    @unique
  verificationToken String?   @unique
  isConfirmed       Boolean   @default(false)
  confirmedAt       DateTime?
  createdAt         DateTime  @default(now())
}

model WebAuthnCredential {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialId String   @unique
  publicKey    String
  counter      Int      @default(0)
  deviceLabel  String?
  createdAt    DateTime @default(now())
}

model WhitelistDestination {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  assetRail        String
  destinationLabel String
  beneficiaryOrg   String
  addressOrIban    String
  status           String   @default("QUARANTINE")
  quarantineUntil  DateTime
  signersRequired  Int      @default(2)
  signersCompleted Int      @default(1)
  approvedSigners  String   @default("[]")
  createdAt        DateTime @default(now())
}

// ------------------------------------------------------------------------------
// Double-Entry Financial Ledger Models
// ------------------------------------------------------------------------------

model LedgerAccount {
  id          String        @id @default(uuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountType String
  currency    String        @default("USD")
  balance     Decimal       @default(0.0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  entries     LedgerEntry[]

  @@unique([userId, accountType, currency])
}

model LedgerTransaction {
  id            String        @id @default(uuid())
  referenceId   String        @unique
  type          String        // DEPOSIT | WITHDRAWAL | TRADE | STAKE | REWARD | DIVIDEND | SWEEP
  status        String        // PENDING | SETTLED | FAILED | PENDING_SECOND_SIGN_OFF
  description   String
  amount        Decimal?      @default(0.0)
  currency      String?       @default("USD")
  rail          String?       // SWISS_SIC | FEDWIRE | ETH | BTC | POLYGON
  counterparty  String?
  accountNumber String?
  createdAt     DateTime      @default(now())

  entries       LedgerEntry[]
}

model LedgerEntry {
  id            String            @id @default(uuid())
  transactionId String
  transaction   LedgerTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  accountId     String
  account       LedgerAccount     @relation(fields: [accountId], references: [id])
  amount        Decimal
  createdAt     DateTime          @default(now())

  @@index([accountId])
  @@index([transactionId])
}

// ------------------------------------------------------------------------------
// Vertical 1: Crypto & Yield Models
// ------------------------------------------------------------------------------

model CryptoHolding {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  symbol        String
  custodyType   String
  quantity      Float
  avgBuyPrice   Float
  stakedAmount  Float    @default(0.0)
  pendingReward Float    @default(0.0)
  apy           Float    @default(0.0)
  updatedAt     DateTime @updatedAt
}

model DcaSchedule {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  symbol     String
  amountUsd  Float
  frequency  String
  nextRunAt  DateTime
  isActive   Boolean   @default(true)
  lastRunAt  DateTime?
  totalSpent Float     @default(0.0)
  createdAt  DateTime  @default(now())
}

// ------------------------------------------------------------------------------
// Vertical 2: Swiss & Global Equities
// ------------------------------------------------------------------------------

model StockPosition {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  symbol       String
  shares       Float
  avgCostBasis Float
  updatedAt    DateTime @updatedAt
}

model StockOrder {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  symbol        String
  orderType     String
  side          String
  shares        Float
  triggerPrice  Float
  status        String   @default("OPEN")
  twapBatchSize Float?
  twapInterval  Int?
  createdAt     DateTime @default(now())
}

// ------------------------------------------------------------------------------
// Vertical 3: Quantitative AI Hedge Funds
// ------------------------------------------------------------------------------

model AiFundPosition {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  strategyTier    String
  allocatedUsd    Float
  unrealizedAlpha Float    @default(0.0)
  circuitBreaker  Boolean  @default(false)
  claimedYield    Float    @default(0.0)
  pendingYield    Float    @default(0.0)
  updatedAt       DateTime @updatedAt
}

model AiRationaleLog {
  id          String   @id @default(uuid())
  strategy    String
  actionType  String
  asset       String
  rationale   String
  slippageBps Float
  confidence  Float
  createdAt   DateTime @default(now())
}

// ------------------------------------------------------------------------------
// Vertical 4: Real Estate Models
// ------------------------------------------------------------------------------

model RealEstateProperty {
  id              String               @id @default(uuid())
  title           String
  region          String
  totalValuation  Float
  totalTokens     Int
  tokenPriceUsd   Float
  annualizedYield Float
  occupancyRate   Float
  spvContractUrl  String
  createdAt       DateTime             @default(now())
  shares          RealEstateShare[]
  otcOrders       RealEstateOtcOrder[]
}

model RealEstateShare {
  id         String             @id @default(uuid())
  userId     String
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  propertyId String
  property   RealEstateProperty @relation(fields: [propertyId], references: [id])
  tokenCount Int
  updatedAt  DateTime           @updatedAt
}

model RealEstateOtcOrder {
  id            String             @id @default(uuid())
  propertyId    String
  property      RealEstateProperty @relation(fields: [propertyId], references: [id])
  orderType     String
  tokenAmount   Int
  pricePerToken Float
  status        String             @default("OPEN")
  createdAt     DateTime           @default(now())
}

// ------------------------------------------------------------------------------
// Vertical 5: Exotic Cars & Horology Models
// ------------------------------------------------------------------------------

model ExoticCar {
  id            String         @id @default(uuid())
  vin           String         @unique
  make          String
  model         String
  year          Int
  vaultLocation String
  insuredValue  Float
  hagertyIndex  Float
  shares        CarShare[]
  driveBookings DriveBooking[]
}

model CarShare {
  id       String    @id @default(uuid())
  userId   String
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  carId    String
  car      ExoticCar @relation(fields: [carId], references: [id])
  sharePct Float
}

model DriveBooking {
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  carId         String
  car           ExoticCar @relation(fields: [carId], references: [id])
  trackLocation String
  bookingDate   DateTime
  status        String    @default("CONFIRMED")
  createdAt     DateTime  @default(now())

  @@unique([carId, bookingDate])
}

// ------------------------------------------------------------------------------
// Vertical 6: VIP Cards
// ------------------------------------------------------------------------------

model VipCard {
  id              String   @id @default(uuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cardNumberLast4 String
  cardType        String   @default("PHYSICAL")
  tier            String   @default("OBSIDIAN")
  isFrozen        Boolean  @default(false)
  dailySpendLimit Float    @default(50000.0)
  pinEncrypted    String
  shippingStatus  String?
  updatedAt       DateTime @updatedAt
}

// ------------------------------------------------------------------------------
// Compliance & Audit
// ------------------------------------------------------------------------------

model KycDocument {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  docType    String
  fileUrl    String
  isVerified Boolean  @default(false)
  uploadedAt DateTime @default(now())
}

model AuditLog {
  id            String   @id @default(uuid())
  userId        String?
  user          User?    @relation(fields: [userId], references: [id])
  actorId       String?
  action        String
  ipHash        String?
  ipAddressHash String?
  userAgent     String?
  metadata      String?
  createdAt     DateTime @default(now())
}
