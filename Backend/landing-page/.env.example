# WavyAssets Landing Page Backend Environment Configuration

# Server Environment
PORT=4000
NODE_ENV=development
APP_URL=http://localhost:4000
CLIENT_URL=http://localhost:5173
DASHBOARD_URL=http://localhost:5174

# Database Connection (SQLite local file)
DATABASE_URL="file:./dev.db"

# Cryptographic & Session Secrets (Replace in production with 64-char hex)
JWT_SECRET="wavy_sovereign_terminal_jwt_secret_dev_key_must_be_rotated_in_prod"
JWT_EXPIRATION="15m"
REFRESH_TOKEN_SECRET="wavy_sovereign_refresh_secret_dev_key_must_be_rotated"
REFRESH_TOKEN_EXPIRATION="7d"
HANDOFF_TICKET_SECRET="replace_with_secure_random_hex_minimum_32_bytes"
FIELD_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Security & Throttling
THROTTLE_TTL=60
THROTTLE_LIMIT=120
AUTH_THROTTLE_LIMIT=5

# Institutional Notification Webhooks (Optional)
SLACK_MANDATE_WEBHOOK_URL=""
TELEGRAM_ALERT_BOT_TOKEN=""
TELEGRAM_ALERT_CHAT_ID=""

# Telemetry Upstream Feeds (Optional)
COINGECKO_API_KEY=""
FINANCIAL_MODELING_PREP_KEY=""

# Primary Transactional Email Gateway (Resend)
EMAIL_PROVIDER="resend" # "resend" (default/production) | "console" (local dev only)
RESEND_API_KEY="re_your_resend_api_key_here"
EMAIL_FROM="WavyAssets Security <security@wavyassets.com>"

# Secondary Encrypted Enclave Dispatch (Accredited & Institutional Tier via Telegram Bot)
TELEGRAM_ENCLAVE_ENABLED="true"
TELEGRAM_ENCLAVE_BOT_TOKEN="your_telegram_bot_token"
TELEGRAM_ENCLAVE_CHAT_ID="your_telegram_enclave_chat_or_channel_id"

# Local Development & Sandbox Mode (STRICT SECURITY INVARIANT: Forbidden & Ignored in Production)
# If NODE_ENV=production, DEV_STATIC_OTP and console fallback are strictly blocked by the AuthGuard.
DEV_STATIC_OTP="123456" # Active ONLY when NODE_ENV=development. Rejected in production with HTTP 403.
DEV_CONSOLE_OTP_FALLBACK="true" # Active ONLY when NODE_ENV=development. Never outputs to stdout in production.
